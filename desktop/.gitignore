node_modules/
dist/
src-tauri/target/
src-tauri/gen/
*.tsbuildinfo

# The sidecar is compiled from ./cmd/ownbasectl by scripts/build-sidecar.mjs.
# A 9 MB binary per platform does not belong in git, and it must match the
# checkout it is built from anyway.
src-tauri/binaries/

# The icons in src-tauri/icons/ ARE committed so a release build does not need
# ImageMagick or the Tauri CLI image pipeline. Rebuild from icon-mark.png via
# scripts/make-icon.mjs; the 1024px file it feeds to `tauri icon` is only an
# intermediate. iOS/Android sets from `tauri icon` are unused (desktop only).
src-tauri/icon-source.png
src-tauri/icons/ios/
src-tauri/icons/android/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
