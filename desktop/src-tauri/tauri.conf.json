{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OwnBase",
  "version": "0.1.0",
  "identifier": "ai.ownbase.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OwnBase",
        "width": 1180,
        "height": 800,
        "minWidth": 880,
        "minHeight": 620,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ownbasectl"],
    "shortDescription": "Own your infrastructure.",
    "longDescription": "Set up a Base, watch its health, and replay every session opened on it. The app is a window onto ownbasectl — it holds no credentials of its own and adds no second way to change what is deployed.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
