---
/**
 * Inline SVG from lucide-static. Zero runtime — the SVG is inlined at
 * build time so the page ships no icon library JS.
 *
 * Name is the lucide icon name in kebab-case (e.g. "shield", "refresh-cw").
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"svg"> & {
  name: string;
  size?: number;
  strokeWidth?: number;
};

const { name, size = 24, strokeWidth = 2, class: className, ...rest } = Astro.props;

// lucide-static exports each icon as a raw SVG string under icons/<Name>.
// Convert kebab-case → PascalCase to match the export key.
const pascal = name
  .split("-")
  .map((p) => p.charAt(0).toUpperCase() + p.slice(1))
  .join("");

const icons = await import("lucide-static");
const raw = (icons as unknown as Record<string, unknown>)[pascal];

if (typeof raw !== "string") {
  throw new Error(`Unknown lucide icon: ${name} (looked up as ${pascal})`);
}

// lucide-static SVGs ship with width/height=24 and stroke-width=2. Rewrite
// those attributes so callers can size and weight freely, and inject the
// className onto the root <svg>.
let svg = raw
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`);

if (className) {
  svg = svg.replace("<svg", `<svg class="${className}"`);
}

// Forward remaining attributes (aria-hidden, etc.)
const attrPairs = Object.entries(rest)
  .filter(([, v]) => v !== undefined && v !== false)
  .map(([k, v]) => (v === true ? k : `${k}="${String(v)}"`))
  .join(" ");
if (attrPairs) {
  svg = svg.replace("<svg", `<svg ${attrPairs}`);
}
---
<Fragment set:html={svg} />
