---
/**
 * The llms.txt CTA card used in the hero and the closing section.
 * Copy is a tiny inline script — no React island for three buttons.
 */
import Icon from "./Icon.astro";
import { llmsUrl } from "../data/comparison";

type Props = {
  /** Compact footer-style card omits the checklist. */
  compact?: boolean;
  class?: string;
};

const { compact = false, class: className } = Astro.props;

const checklist = [
  "Install OwnBase on your server",
  "Configure networking, certificates and DNS",
  "Harden the system and close what shouldn't be open",
  "Set up encrypted backups and verify they restore",
  "Deploy your applications and confirm they're healthy",
];
---

<div
  class:list={[
    "rounded-2xl border border-accent-line bg-surface p-5 sm:p-6 shadow-sm",
    className,
  ]}
  data-copy-card
>
  {
    !compact && (
      <p class="text-sm font-medium text-fg">
        Paste this into Claude Code, Codex, Cursor, or your favourite coding
        agent.
      </p>
    )
  }
  {
    compact && (
      <p class="text-base font-semibold text-fg">Start with one URL.</p>
    )
  }

  <div
    class:list={[
      "rounded-xl border border-accent-line bg-accent-soft/60 px-4 py-3 font-mono text-sm text-accent-fg break-all",
      compact ? "mt-3" : "mt-4",
    ]}
  >
    {llmsUrl}
  </div>

  {
    !compact && (
      <div class="mt-5">
        <p class="text-sm font-medium text-fg">Your agent will:</p>
        <ul class="mt-2 space-y-1.5">
          {checklist.map((item) => (
            <li class="flex items-start gap-2 text-sm text-fg-muted">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-fg-faint" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    compact && (
      <p class="mt-3 text-sm text-fg-muted">
        Paste it into your coding agent. Everything else happens from there.
      </p>
    )
  }

  <button
    type="button"
    class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
    data-copy-url={llmsUrl}
  >
    <Icon name="copy" size={16} strokeWidth={2} class="shrink-0" aria-hidden="true" />
    <span data-copy-label>Copy URL</span>
  </button>

</div>

<script>
  function wireCopy(root: ParentNode = document) {
    root.querySelectorAll<HTMLButtonElement>("[data-copy-url]").forEach((btn) => {
      if (btn.dataset.wired === "1") return;
      btn.dataset.wired = "1";
      const url = btn.dataset.copyUrl ?? "";
      const label = btn.querySelector<HTMLElement>("[data-copy-label]");
      const original = label?.textContent ?? "Copy URL";
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
          if (label) label.textContent = "Copied";
          btn.classList.add("bg-accent-hover");
          window.setTimeout(() => {
            if (label) label.textContent = original;
            btn.classList.remove("bg-accent-hover");
          }, 1600);
        } catch {
          // Fallback for older browsers / denied clipboard permission.
          window.prompt("Copy this URL:", url);
        }
      });
    });
  }

  wireCopy();
  document.addEventListener("astro:page-load", () => wireCopy());
</script>
