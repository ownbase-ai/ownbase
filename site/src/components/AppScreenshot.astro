---
/**
 * Placeholder for the OwnBase desktop app screenshot used in the
 * "Built for AI" section. Drop a real 2400×1500 PNG at
 * src/assets/app-screenshot.png and swap the import below.
 */
---

<div
  class="relative overflow-hidden rounded-xl border border-white/10 bg-[#0c1222] shadow-2xl shadow-black/40"
  role="img"
  aria-label="OwnBase desktop app — services overview (placeholder)"
>
  <!-- Title bar -->
  <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="ml-3 font-mono text-[11px] text-white/40">OwnBase · ct-mx-1</span>
    <span class="ml-auto rounded bg-white/10 px-2 py-0.5 text-[10px] text-white/50">Refresh</span>
  </div>

  <div class="grid grid-cols-[9.5rem_1fr] min-h-[18rem] sm:min-h-[22rem]">
    <!-- Sidebar -->
    <aside class="hidden border-r border-white/10 bg-black/30 p-3 sm:block">
      <p class="px-2 text-[10px] font-semibold uppercase tracking-wider text-white/30">Bases</p>
      <div class="mt-2 rounded-md bg-accent/20 px-2 py-1.5 text-xs font-medium text-white">
        <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-good"></span>
        ct-mx-1
      </div>
      <div class="mt-1 px-2 py-1.5 text-xs text-white/40">test</div>
      <p class="mt-5 px-2 text-[10px] font-semibold uppercase tracking-wider text-white/30">Audit</p>
      <div class="mt-1 px-2 py-1.5 text-xs text-white/50">Sessions</div>
      <p class="mt-5 px-2 text-[10px] font-semibold uppercase tracking-wider text-white/30">Credentials</p>
      <div class="mt-1 px-2 py-1.5 text-xs text-white/50">Vault</div>
    </aside>

    <!-- Main -->
    <div class="p-4 sm:p-5">
      <div class="flex items-center gap-3 border-b border-white/10 pb-3">
        <div>
          <p class="font-mono text-sm font-medium text-white">ct-mx-1</p>
          <p class="mt-0.5 font-mono text-[11px] text-white/40">ownbase@v0.4.2 · 167.235.47.254</p>
        </div>
      </div>

      <div class="mt-3 flex gap-4 border-b border-white/10 text-[11px]">
        <span class="border-b-2 border-accent pb-2 text-white">Overview</span>
        <span class="pb-2 text-white/40">Services</span>
        <span class="pb-2 text-white/40">Security</span>
        <span class="pb-2 text-white/40">Backups</span>
        <span class="hidden pb-2 text-white/40 sm:inline">Updates</span>
        <span class="hidden pb-2 text-white/40 sm:inline">Activity</span>
      </div>

      <div class="mt-4 space-y-2">
        {
          [
            { name: "api", ref: "github.com/…/crossterra", state: "running" },
            { name: "demo", ref: "github.com/…/crossterra", state: "running" },
            { name: "elasticsearch", ref: "github.com/…/revolve-search", state: "running" },
            { name: "pgbackrest", ref: "github.com/ownbase-ai/pgbackrest", state: "running" },
            { name: "postgres", ref: "github.com/ownbase-ai/pgbackrest", state: "running" },
          ].map((s) => (
            <div class="flex items-center gap-3 rounded-lg border border-white/5 bg-white/[0.03] px-3 py-2">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-good" />
              <div class="min-w-0 flex-1">
                <p class="truncate font-mono text-xs text-white">{s.name}</p>
                <p class="truncate font-mono text-[10px] text-white/35">{s.ref}</p>
              </div>
              <span class="hidden shrink-0 rounded-full bg-good/15 px-2 py-0.5 text-[10px] font-medium text-good sm:inline">
                {s.state}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
