---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CopyUrl from "../components/CopyUrl.astro";
import CopyButton from "../components/CopyButton.astro";
import AppScreenshot from "../components/AppScreenshot.astro";
import WorksWith from "../components/WorksWith.astro";
import {
  saasCards,
  observedTotal,
  basePlan,
  baseServices,
} from "../data/comparison";
import mark from "../assets/icon-mark.png";

const features = [
  {
    title: "Secure by default",
    icon: "shield",
    bullets: [
      "Firewall and SSH hardening",
      "Automatic security updates",
      "Secrets encrypted, never in git",
    ],
  },
  {
    title: "Backups you've tested",
    icon: "database",
    bullets: [
      "Encrypted and off-machine",
      "Append-only, ransomware-proof",
      "Restores verified, not assumed",
    ],
  },
  {
    title: "Deploy anything",
    icon: "box",
    bullets: [
      "Containers, sites, APIs, workers",
      "Postgres and other databases",
      "Built from source, pinned",
    ],
  },
  {
    title: "Rebuild from nothing",
    icon: "refresh-cw",
    bullets: [
      "Your whole server is in git",
      "Lose the machine, restore it",
      "Same services, same data",
    ],
  },
];

const agentPoints = [
  {
    icon: "copy-plus",
    title: "One line to scale",
    body: "Need four agents? Change a number. No new product to buy.",
  },
  {
    icon: "hard-drive",
    title: "Each agent keeps its workspace",
    body: "State stays on the worker that owns it. Nothing shared by accident.",
  },
  {
    icon: "waypoints",
    title: "You control the routing",
    body: "Which agent gets which job is your code — not a black-box scheduler.",
  },
  {
    icon: "cpu",
    title: "Same machine as production",
    body: "Real logs, real deploys. Nothing through us.",
  },
];
---

<Base>
  <!-- 1. Hero -->
  <section class="container-content py-14 sm:py-20 lg:py-24">
    <div class="grid items-start gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div>
        <h1
          class="display text-[clamp(2.5rem,7vw,4.75rem)] font-medium leading-[1.05] tracking-tight text-fg"
        >
          Build faster.<br />
          Own everything.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-fg-muted sm:text-xl">
          One server you own that runs everything you build with AI.
        </p>
        <p class="mt-5 text-sm leading-relaxed text-fg-subtle">
          <span class="inline rounded-md bg-accent-soft px-1.5 py-0.5 text-accent-fg">
            No SaaS lock-in. No software subscriptions.
          </span>
        </p>
      </div>
      <CopyUrl />
    </div>
  </section>

  <!-- 2. Eight subscriptions, or one server -->
  <section class="border-t border-line bg-surface-muted/40 py-16 sm:py-20">
    <div class="container-content">
      <div class="max-w-2xl">
        <h2 class="display text-3xl font-medium tracking-tight text-fg sm:text-4xl">
          Eight subscriptions, or one server.
        </h2>
        <p class="mt-3 text-base leading-relaxed text-fg-muted sm:text-lg">
          The same capabilities, on hardware you rent outright&nbsp;— with no
          vendor between you and your own data.
        </p>
      </div>

      <div class="mt-10 grid items-stretch gap-8 lg:grid-cols-[1fr_auto_22rem] lg:gap-6">
        <!-- SaaS grid -->
        <div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {
              saasCards.map((card) => (
                <div class="rounded-xl border border-line bg-surface p-4">
                  <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface-sunken text-fg-muted">
                    <Icon name={card.icon} size={18} strokeWidth={1.75} aria-hidden="true" />
                  </div>
                  <p class="mt-3 text-sm font-semibold text-fg">{card.name}</p>
                  <p class="mt-0.5 text-xs text-fg-subtle">{card.examples}</p>
                  <p class="mt-2 text-sm font-medium text-fg">{card.price}</p>
                  <span class="mt-2 inline-block rounded-md border border-line bg-surface-muted px-1.5 py-0.5 text-[10px] font-medium text-fg-faint">
                    Separate account
                  </span>
                </div>
              ))
            }
          </div>
          <p class="mt-5 text-sm text-fg-muted">
            Observed total: <span class="font-semibold text-fg">{observedTotal}</span>
          </p>
        </div>

        <!-- Connector (desktop only) -->
        <div class="hidden flex-col items-center justify-center lg:flex" aria-hidden="true">
          <div class="relative flex h-full min-h-[16rem] w-16 items-center justify-center">
            <svg class="absolute inset-0 h-full w-full" viewBox="0 0 64 280" fill="none" preserveAspectRatio="none">
              <path d="M8 40 C 28 40, 36 120, 48 140" stroke="rgb(var(--color-accent-line))" stroke-width="1.5" stroke-dasharray="3 4" />
              <path d="M8 100 C 28 100, 36 130, 48 140" stroke="rgb(var(--color-accent-line))" stroke-width="1.5" stroke-dasharray="3 4" />
              <path d="M8 160 C 28 160, 36 150, 48 140" stroke="rgb(var(--color-accent-line))" stroke-width="1.5" stroke-dasharray="3 4" />
              <path d="M8 220 C 28 220, 36 160, 48 140" stroke="rgb(var(--color-accent-line))" stroke-width="1.5" stroke-dasharray="3 4" />
              <path d="M48 140 H 58" stroke="rgb(var(--color-accent))" stroke-width="1.5" />
              <path d="M54 136 L 60 140 L 54 144" stroke="rgb(var(--color-accent))" stroke-width="1.5" fill="none" stroke-linejoin="round" />
            </svg>
            <img
              src={mark.src}
              alt=""
              width="36"
              height="36"
              class="relative z-10 h-9 w-9 object-contain drop-shadow-sm"
            />
          </div>
        </div>

        <!-- Mobile chevron -->
        <div class="flex justify-center lg:hidden" aria-hidden="true">
          <div class="flex h-10 w-10 items-center justify-center rounded-full border border-accent-line bg-accent-soft">
            <Icon name="arrow-down" size={18} class="text-accent" />
          </div>
        </div>

        <!-- Your Base card -->
        <div class="rounded-2xl border border-accent-line bg-surface p-6 shadow-sm">
          <h3 class="display text-2xl font-medium text-fg">{basePlan.name}</h3>
          <p class="mt-1 text-sm font-medium text-accent">{basePlan.machine}</p>
          <ul class="mt-5 space-y-2.5">
            {
              baseServices.map((s) => (
                <li class="flex items-center gap-2.5 text-sm text-fg">
                  <span class="h-2 w-2 shrink-0 rounded-full bg-good" aria-hidden="true" />
                  <Icon name={s.icon} size={16} strokeWidth={1.75} class="text-fg-muted" aria-hidden="true" />
                  <span>{s.name}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm font-medium text-fg">{basePlan.tagline}</p>
          <CopyButton class="mt-4" />
          <p class="mt-3 text-center text-xs text-fg-faint">
            Paste this URL into your AI coding agent.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. Built for AI -->
  <section class="bg-[#0a0f1c] py-16 text-white sm:py-20">
    <div class="container-content grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div>
        <h2 class="display text-3xl font-medium tracking-tight sm:text-4xl lg:text-5xl">
          Built for AI.<br />
          And humans.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-white/70 sm:text-lg">
          Agents need a real computer, not a tenancy. On a Base, AI can read
          logs, inspect processes, stand up a database, and verify what it just
          did&nbsp;— no accounts to open, no API keys to provision, no vendor
          roadblocks outside its control.
        </p>
        <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
          You get a machine that stays healthy without you. Firewalls, patches,
          certificates, backups, recovery&nbsp;— handled.           Monitor security and updates from the app; otherwise keep building,
          and the Base keeps the lights on.
        </p>
      </div>
      <AppScreenshot />
    </div>
  </section>

  <!-- 4. Feature quad -->
  <section class="border-b border-line py-16 sm:py-20">
    <div class="container-content grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        features.map((f) => (
          <div>
            {/*
              Icon beside title when the quad collapses (< lg). On the 4-up
              desktop row, icon stacks above title as in the design.
            */}
            <div class="flex items-center gap-3 lg:flex-col lg:items-start lg:gap-0">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent text-white">
                <Icon name={f.icon} size={22} strokeWidth={1.75} aria-hidden="true" />
              </div>
              <h3 class="text-xl font-semibold text-fg sm:text-2xl lg:mt-4 lg:text-lg">
                {f.title}
              </h3>
            </div>
            {/* pl matches icon (44px) + gap (12px) so bullets hang under the title when side-by-side */}
            <ul class="mt-4 space-y-2.5 pl-14 lg:pl-0">
              {f.bullets.map((b) => (
                <li class="flex items-start gap-2 text-base text-fg-muted sm:text-lg lg:text-sm">
                  <Icon
                    name="circle-check"
                    size={18}
                    strokeWidth={2}
                    class="mt-0.5 shrink-0 text-accent"
                    aria-hidden="true"
                  />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 5. Nothing is hidden + agent harness -->
  <section class="py-16 sm:py-20">
    <div class="container-content grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Nothing is hidden — top padding matches the agent card so titles share a baseline -->
      <div class="lg:pt-8">
        <h2 class="display text-3xl font-medium tracking-tight text-fg sm:text-4xl">
          Nothing is hidden.
        </h2>
        <p class="mt-4 max-w-md text-base leading-relaxed text-fg-muted">
          Your whole server is a file you can read. Change it, commit it, and
          the machine reconciles to match. That's why an agent can operate
          it&nbsp;— and why you can audit what it did.
        </p>

        <div class="mt-8">
          {/*
            One grid row per source line. Callouts live in column 2 of the
            same row as the line they explain. Code cells use whitespace-pre
            so YAML indentation survives HTML space-collapsing. Borders are
            only left/right/bottom as needed so the card reads as one block
            (no gap between highlighted rows).
          */}
          <div class="grid grid-cols-1 font-mono text-[13px] leading-6 lg:grid-cols-[minmax(16rem,1fr)_auto]">
            <!-- Header -->
            <div class="flex rounded-t-xl border border-line bg-surface-sunken/80 text-[11px] leading-none text-fg-faint">
              <span class="flex h-9 w-10 shrink-0 items-center justify-end border-r border-line px-2"></span>
              <span class="flex items-center px-3">ownbase.yaml</span>
            </div>
            <div class="hidden lg:block" aria-hidden="true"></div>

            <!-- Lines 1–3. min-h-6 + h-full so cells stretch when a callout
                 on the same row is taller than the code line (otherwise the
                 grid row grows and leaves a white gap in the card). -->
            <div class="flex h-full min-h-6 items-center border-x border-line bg-surface-muted text-fg">
              <span class="flex h-full w-10 shrink-0 select-none items-center justify-end border-r border-line bg-surface-sunken/40 px-2 text-fg-faint">1</span>
              <span class="px-3 text-fg-subtle">services:</span>
            </div>
            <div class="hidden lg:block" aria-hidden="true"></div>

            <div class="flex h-full min-h-6 items-center border-x border-line bg-surface-muted text-fg">
              <span class="flex h-full w-10 shrink-0 select-none items-center justify-end border-r border-line bg-surface-sunken/40 px-2 text-fg-faint">2</span>
              <span class="whitespace-pre px-3">{"  "}<span class="text-accent">api</span>:</span>
            </div>
            <div class="hidden lg:block" aria-hidden="true"></div>

            <div class="flex h-full min-h-6 items-center border-x border-line bg-surface-muted text-fg">
              <span class="flex h-full w-10 shrink-0 select-none items-center justify-end border-r border-line bg-surface-sunken/40 px-2 text-fg-faint">3</span>
              <span class="whitespace-pre px-3">{"    "}repo: <span class="text-fg">github.com/you/api</span></span>
            </div>
            <div class="hidden lg:block" aria-hidden="true"></div>

            <!-- Line 4 + callout -->
            <div class="flex h-full min-h-6 items-center border-x border-line bg-accent-soft/60 text-fg">
              <span class="flex h-full w-10 shrink-0 select-none items-center justify-end border-r border-line bg-surface-sunken/40 px-2 text-fg-faint">4</span>
              <span class="whitespace-pre px-3">{"    "}ref: <span class="text-accent-fg">9f2c1ab</span></span>
            </div>
            <div class="hidden items-center py-0.5 lg:flex">
              <span class="h-px w-4 shrink-0 bg-accent-line" aria-hidden="true"></span>
              <span class="whitespace-nowrap rounded-md border border-accent-line bg-surface px-2 py-0.5 font-sans text-[11px] font-medium text-fg shadow-sm">
                Pinned commit, built from source.
              </span>
            </div>

            <!-- Line 5 + callout -->
            <div class="flex h-full min-h-6 items-center rounded-b-xl border-x border-b border-line bg-accent-soft/60 text-fg">
              <span class="flex h-full w-10 shrink-0 select-none items-center justify-end border-r border-line bg-surface-sunken/40 px-2 text-fg-faint">5</span>
              <span class="whitespace-pre px-3">{"    "}domains: [<span class="text-accent-fg">api.example.com</span>]</span>
            </div>
            <div class="hidden items-center py-0.5 lg:flex">
              <span class="h-px w-4 shrink-0 bg-accent-line" aria-hidden="true"></span>
              <span class="whitespace-nowrap rounded-md border border-accent-line bg-surface px-2 py-0.5 font-sans text-[11px] font-medium text-fg shadow-sm">
                Certificate issued automatically.
              </span>
            </div>
          </div>

          <ul class="mt-3 space-y-1.5 pl-10 font-sans lg:hidden">
            <li class="flex items-start gap-2 text-xs text-fg-muted">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              <span><span class="font-mono text-accent-fg">ref</span> — pinned commit, built from source.</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-fg-muted">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              <span><span class="font-mono text-accent-fg">domains</span> — certificate issued automatically.</span>
            </li>
          </ul>

          <a
            href="https://github.com/ownbase-ai/ownbase/blob/main/docs/ownbase-yaml.md"
            class="mt-5 inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3.5 py-2 text-sm font-medium text-fg transition-colors hover:border-accent-line hover:bg-accent-soft hover:text-accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            Read the config format
            <Icon name="arrow-right" size={14} aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Agent harness + replicas -->
      <div class="rounded-2xl border border-line bg-surface-muted/50 p-6 sm:p-8">
        <h2 class="display text-3xl font-medium tracking-tight text-fg sm:text-4xl">
          Run a pool of AI agents on it.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-fg-muted">
          Spin up as many coding agents as you need on the same server as your
          apps. They run on hardware you control&nbsp;— not a separate product,
          and nothing routed through us.
        </p>

        <ul class="mt-6 grid gap-5 sm:grid-cols-2">
          {
            agentPoints.map((p) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-line bg-surface text-fg-muted">
                  <Icon name={p.icon} size={16} strokeWidth={1.75} aria-hidden="true" />
                </span>
                <div>
                  <p class="text-sm font-semibold text-fg">{p.title}</p>
                  <p class="mt-1 text-sm leading-snug text-fg-muted">{p.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <a
            href="https://github.com/ownbase-ai/ownbase/blob/main/docs/ownbase-yaml.md#replicas-replicas"
            class="inline-flex items-center gap-1.5 rounded-lg border border-accent-line bg-surface px-4 py-2.5 text-sm font-medium text-accent transition-colors hover:bg-accent-soft"
            target="_blank"
            rel="noopener noreferrer"
          >
            How replicas work
            <Icon name="arrow-right" size={16} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Works with -->
  <WorksWith />

  <!-- 7. Closing -->
  <section class="py-16 sm:py-20">
    <div class="container-content grid items-start gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
      <div>
        <h2 class="display text-3xl font-medium tracking-tight text-fg sm:text-4xl lg:text-5xl">
          If we disappear,<br />nothing stops working.
        </h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <p class="text-sm leading-relaxed text-fg-muted sm:text-base">
            There's no account, no control plane, and no server of ours that
            your Base depends on. OwnBase is MIT licensed and you are free to
            fork it, audit it, or ignore us entirely&nbsp;— your server keeps
            running either way.
          </p>
          <p class="text-sm leading-relaxed text-fg-muted sm:text-base">
            AI made building software cheap. Keeping it online still usually
            means a stack of monthly platform bills. OwnBase replaces that rent
            with one server you own.
          </p>
        </div>
      </div>
      <CopyUrl compact />
    </div>
  </section>
</Base>
